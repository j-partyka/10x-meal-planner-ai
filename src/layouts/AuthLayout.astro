---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { ToasterMount } from "../components/ToasterMount";

interface Props {
  title?: string;
}

const { title = "10x Meal Planner" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border/60 px-4 py-4 sm:px-6">
        <a
          href="/login"
          class="text-lg font-semibold tracking-tight text-foreground transition-colors hover:text-foreground/80"
          data-test-id="auth-layout-brand"
        >
          10x Meal Planner
        </a>
      </header>
      <slot />
    </div>
    <ToasterMount client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
