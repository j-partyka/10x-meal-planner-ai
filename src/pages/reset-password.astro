---
export const prerender = false;

import AuthLayout from "../layouts/AuthLayout.astro";
import { ResetPasswordPage } from "../components/auth/ResetPasswordPage";

const queryInvalid = Astro.url.searchParams.get("error") === "invalid";
---

<AuthLayout title="Reset password – 10x Meal Planner">
  <main class="flex min-h-full flex-1 flex-col items-center justify-center px-4 py-12" role="main" data-test-id="reset-password-page">
    <ResetPasswordPage client:load queryInvalid={queryInvalid} />
  </main>
</AuthLayout>
